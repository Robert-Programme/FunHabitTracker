@model FunHabitTracker.ViewModels.TodayDashboardModel
@using FunHabitTracker.Models
@using FunHabitTracker.ViewModels
@{
    ViewData["Title"] = "Heute";
}

<section class="page-heading">
    <div>
        <p class="eyebrow">@Model.Date.ToString("dddd, dd. MMMM")</p>
        <h1>Heute</h1>
    </div>
    <div class="completion-summary" aria-label="@Model.DoneCount von @Model.DueCount erledigt">
        <strong>@Model.CompletionPercent%</strong>
        <span>@Model.DoneCount von @Model.DueCount erledigt</span>
    </div>
</section>

<div class="progress-track" aria-hidden="true"><span style="width: @Model.CompletionPercent%"></span></div>

@if (Model.Habits.Count == 0)
{
    <section class="empty-state">
        <h2>Heute ist frei</h2>
        <p>Es sind keine aktiven Habits eingeplant.</p>
        <a class="button button-primary" asp-controller="Habits" asp-action="Create">Gewohnheit anlegen</a>
    </section>
}
else
{
    <section class="habit-list" aria-label="Habits fuer heute">
        @foreach (var habit in Model.Habits)
        {
            var statusClass = habit.Status switch { TodayStatus.Done => "is-done", TodayStatus.Skipped => "is-skipped", _ => "is-pending" };
            <article class="habit-row @statusClass">
                <div class="habit-main">
                    <form asp-action="SetOutcome" method="post" class="status-form">
                        <input type="hidden" name="habitId" value="@habit.Id" />
                        <input type="hidden" name="outcome" value="Done" />
                        <button class="status-symbol" type="submit" aria-label="@(habit.Status == TodayStatus.Done ? $"{habit.Name} wieder als offen markieren" : $"{habit.Name} erledigen")" aria-pressed="@(habit.Status == TodayStatus.Done ? "true" : "false")">@(habit.Status == TodayStatus.Done ? "OK" : habit.Status == TodayStatus.Skipped ? "--" : "o")</button>
                    </form>
                    <div class="habit-copy">
                        <h2><a asp-controller="Habits" asp-action="History" asp-route-id="@habit.Id">@habit.Name</a></h2>
                        @if (!string.IsNullOrWhiteSpace(habit.Description)) { <p>@habit.Description</p> }
                        <span class="habit-meta">@habit.CurrentStreak Tage Serie</span>
                    </div>
                </div>
                <div class="outcome-actions" aria-label="Status fuer @habit.Name">
                    <form asp-action="SetOutcome" method="post"><input type="hidden" name="habitId" value="@habit.Id" /><input type="hidden" name="outcome" value="Done" /><button class="outcome-button done" type="submit" aria-pressed="@(habit.Status == TodayStatus.Done ? "true" : "false")">Erledigt</button></form>
                    <form asp-action="SetOutcome" method="post"><input type="hidden" name="habitId" value="@habit.Id" /><input type="hidden" name="outcome" value="Skipped" /><button class="outcome-button skipped" type="submit" aria-pressed="@(habit.Status == TodayStatus.Skipped ? "true" : "false")">Ueberspringen</button></form>
                    <form asp-action="ClearOutcome" method="post"><input type="hidden" name="habitId" value="@habit.Id" /><button class="outcome-button pending" type="submit" aria-pressed="@(habit.Status == TodayStatus.Pending ? "true" : "false")">Offen</button></form>
                </div>
            </article>
        }
    </section>
}
