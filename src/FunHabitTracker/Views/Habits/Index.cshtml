@model IReadOnlyList<FunHabitTracker.ViewModels.HabitListItemModel>
@{
    ViewData["Title"] = "Habits";
}

<section class="page-heading">
    <div><p class="eyebrow">Deine Routinen</p><h1>Habits</h1></div>
    <a class="button button-primary" asp-action="Create">Neues Habit</a>
</section>

@if (Model.Count == 0)
{
    <section class="empty-state"><h2>Noch keine Habits</h2><p>Lege dein erstes Habit an.</p></section>
}
else
{
    <div class="management-list">
        @foreach (var habit in Model)
        {
            <article class="management-row @(habit.IsArchived ? "is-archived" : "")">
                <div>
                    <div class="title-line"><h2><a asp-action="History" asp-route-id="@habit.Id">@habit.Name</a></h2>@if (habit.IsArchived) { <span class="status-label">Archiviert</span> }</div>
                    @if (!string.IsNullOrWhiteSpace(habit.Description)) { <p>@habit.Description</p> }
                    <p class="habit-meta">@habit.ScheduleLabel · ab @habit.StartDate.ToString("dd.MM.yyyy") · @habit.CurrentStreak Tage Serie</p>
                </div>
                <div class="row-actions">
                    <a class="button button-secondary" asp-action="Edit" asp-route-id="@habit.Id">Bearbeiten</a>
                    @if (habit.IsArchived)
                    {
                        <form asp-action="Restore" method="post"><input type="hidden" name="id" value="@habit.Id" /><button class="button button-secondary" type="submit">Aktivieren</button></form>
                    }
                    else
                    {
                        <form asp-action="Archive" method="post"><input type="hidden" name="id" value="@habit.Id" /><button class="button button-danger" type="submit">Archivieren</button></form>
                    }
                </div>
            </article>
        }
    </div>
}
