@model FunHabitTracker.ViewModels.HabitHistoryModel
@using FunHabitTracker.ViewModels
@{ ViewData["Title"] = Model.Habit.Name; }
<section class="page-heading history-heading"><div><p class="eyebrow">@Model.Habit.ScheduleLabel</p><h1>@Model.Habit.Name</h1>@if (!string.IsNullOrWhiteSpace(Model.Habit.Description)) { <p>@Model.Habit.Description</p> }</div><div class="heading-actions"><a class="button button-secondary" asp-controller="Home" asp-action="Today">Zurück zu Heute</a><a class="button button-secondary" asp-action="Edit" asp-route-id="@Model.Habit.Id">Bearbeiten</a></div></section>
<section class="stats-band"><div><strong>@Model.Habit.CurrentStreak</strong><span>Aktuelle Serie</span></div><div><strong>@Model.DoneCount</strong><span>Erledigt in 6 Wochen</span></div><div><strong>@Model.ScheduledCount</strong><span>Geplante Tage</span></div></section>
<section class="history-section"><h2>Letzte 6 Wochen</h2><div class="history-grid" aria-label="Habit-Verlauf der letzten 6 Wochen">@foreach (var day in Model.Days) { var css = day.Status == TodayStatus.Done ? "done" : day.Status == TodayStatus.Skipped ? "skipped" : !day.IsScheduled ? "not-scheduled" : "missed"; <div class="history-day @css" title="@day.Date.ToString("dd.MM.yyyy") - @css"><span>@day.Date.Day</span></div> }</div><div class="history-legend"><span><i class="done"></i> Erledigt</span><span><i class="skipped"></i> Uebersprungen</span><span><i class="missed"></i> Offen</span></div></section>
