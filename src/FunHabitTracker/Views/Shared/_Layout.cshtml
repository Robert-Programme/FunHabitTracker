@{
    var controller = ViewContext.RouteData.Values["controller"]?.ToString();
    var currentSection = controller switch
    {
        "Habits" => "habits",
        "Backup" => "data",
        _ => "today"
    };
}
<!DOCTYPE html>
<html lang="de">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="light dark" />
    <title>@ViewData["Title"] - Fun Habit Tracker</title>
    <link rel="icon" type="image/png" href="~/img/app-icon.png" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <header class="app-header">
        <a class="brand" asp-controller="Home" asp-action="Today" aria-label="Fun Habit Tracker, Heute">
            <span class="brand-mark" aria-hidden="true">F</span>
            <span>Fun Habit Tracker</span>
        </a>
        <nav class="primary-nav" aria-label="Hauptnavigation">
            <a class="@(currentSection == "today" ? "is-current" : null)" aria-current="@(currentSection == "today" ? "page" : null)" asp-controller="Home" asp-action="Today">Heute</a>
            <a class="@(currentSection == "habits" ? "is-current" : null)" aria-current="@(currentSection == "habits" ? "page" : null)" asp-controller="Habits" asp-action="Index">Habits</a>
            <a class="@(currentSection == "data" ? "is-current" : null)" aria-current="@(currentSection == "data" ? "page" : null)" asp-controller="Backup" asp-action="Index">Daten</a>
        </nav>
        <a class="button button-primary header-action" asp-controller="Habits" asp-action="Create">Neues Habit</a>
    </header>
    <main class="page-shell">
        @if (TempData["Success"] is string success)
        {
            <div class="notice notice-success" role="status">@success</div>
        }
        @if (TempData["Error"] is string error)
        {
            <div class="notice notice-error" role="alert">@error</div>
        }
        @RenderBody()
    </main>
    <div class="surface-switch">
        <a class="button button-secondary" asp-controller="Home" asp-action="Compact" data-open-compact>Miniaturansicht öffnen</a>
    </div>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
