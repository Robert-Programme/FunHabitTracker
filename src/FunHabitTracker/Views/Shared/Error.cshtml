@model FunHabitTracker.ViewModels.ErrorViewModel
@{ ViewData["Title"] = "Fehler"; }
<section class="empty-state error-state"><h1>Das hat nicht funktioniert</h1><p>Die Aktion konnte nicht abgeschlossen werden. Deine bestehenden Daten wurden nicht absichtlich veraendert.</p>@if (!string.IsNullOrWhiteSpace(Model.RequestId)) { <p class="habit-meta">Vorgang: @Model.RequestId</p> }<a class="button button-primary" asp-controller="Home" asp-action="Today">Zurueck zu Heute</a></section>
